# Copy to .env on the EC2 box (or set as environment vars before `docker compose up`).
# These drive the nginx + certbot setup, not the Vite build.

# Fully-qualified domain name pointing at the EC2 public IP.
# Examples: kmch.duckdns.org, app.example.com
FQDN=kmch.duckdns.org

# Email Let's Encrypt uses for expiry reminders.
CERTBOT_EMAIL=you@example.com
